---
import { Logs, Server, X } from "@lucide/astro";

const navItems = [
  { path: "/", label: "blog" },
  { path: "/notas", label: "notas" },
  { path: "/about", label: "about" },
];
---

<nav>
  <div class="nav nav--always-visible">
    <img class="nav__logo" src="/logo.png" alt="" width="28" height="28" />
    <a href="/" class="nav__username">~/joseprogramando</a>
    <button
      id="menu"
      class="menu-icon"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Logs id="logs-icon" />
      <X id="close-menu" color="#ff6b35" stroke-width={3} class="hidden" />
    </button>
  </div>

  <div id="menu-backdrop" class="menu-backdrop"></div>

  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu__nav">
      {
        navItems.map((item, idx) => (
          <a href={item.path} class="mobile-menu__link">
            <p class="mobile-menu__idx">[{idx + 1}]</p>
            <p class="mobile-menu__label">
              <span>/</span>
              {item.label}
            </p>
          </a>
        ))
      }
    </div>

    <hr />
    <div class="system">
      <div class="system__title">
        <Server color="#ff6b35" size={16} />
        <p>SYSTEM STATUS</p>
      </div>
      <div class="system__info">
        <p class="system__user">josepro@menu:~$ <span>uptime</span></p>
        <p class="system__uptime">24 days, 6:42</p>
      </div>
      <div class="social-media">
        <p>[github]</p>
        <p>[twitter]</p>
      </div>
    </div>
  </div>
</nav>

<script>
  const $menuBtn = document.getElementById("menu"),
    $mobileMenu = document.getElementById("mobile-menu"),
    $backdrop = document.getElementById("menu-backdrop"),
    $logsIcon = document.getElementById("logs-icon"),
    $closeIcon = document.getElementById("close-menu");

  function setOpen(open: boolean) {
    $mobileMenu?.classList.toggle("show", open);
    $backdrop?.classList.toggle("show", open);
    $logsIcon?.classList.toggle("hidden", open);
    $closeIcon?.classList.toggle("hidden", !open);
    $menuBtn?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  $menuBtn?.addEventListener("click", () => {
    setOpen(!$mobileMenu?.classList.contains("show"));
  });

  $backdrop?.addEventListener("click", () => setOpen(false));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // marcar la ruta actual en el menu
  const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
  document.querySelectorAll(".mobile-menu__link").forEach((link) => {
    const href = link.getAttribute("href");
    if (
      href === currentPath ||
      (href !== "/" && currentPath.startsWith(href + "/"))
    ) {
      link.classList.add("active");
    }
  });
</script>

<style>
  /* --- barra: abajo en mobile, arriba en desktop --- */
  .nav {
    background-color: var(--background-dark);
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 4rem;
    padding: 0.5rem 1rem;
    padding-bottom: calc(0.5rem + env(safe-area-inset-bottom));
    border-top: 1px solid #333333;
    z-index: 999;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  /* espacio para que el contenido no quede oculto tras la barra */
  :global(body) {
    padding-bottom: calc(4rem + env(safe-area-inset-bottom));
  }

  .nav__logo {
    border-radius: 6px;
    flex-shrink: 0;
  }

  .nav__username {
    color: inherit;
    text-decoration: none;
    font-weight: bold;
    display: flex;
    align-items: center;
  }

  .nav__username:hover {
    opacity: 0.8;
  }

  .menu-icon {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 8px;
  }

  /* --- backdrop --- */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.55);
    z-index: 997;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-out;
  }

  .menu-backdrop.show {
    opacity: 1;
    pointer-events: auto;
  }

  /* --- panel: sheet que sube desde la barra en mobile --- */
  .mobile-menu {
    position: fixed;
    bottom: calc(4rem + env(safe-area-inset-bottom));
    left: 0;
    right: 0;
    background-color: var(--background-dark);
    border-top: 1px solid #333333;
    z-index: 998;
    display: flex;
    /* system status arriba, links abajo: al alcance del pulgar */
    flex-direction: column-reverse;
    padding: 1rem;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
    transform: translateY(10px);
  }

  .mobile-menu.show {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu__link {
    color: inherit;
    text-decoration: none;
    padding: 0.75rem 0.5rem;
    font-weight: bold;
    display: flex;
    gap: 12px;
    border-radius: 4px;
  }

  .mobile-menu__link:hover {
    background-color: var(--bg-dark-light);
  }
  .mobile-menu__link.active .mobile-menu__label {
    color: var(--orange);
  }
  .mobile-menu__idx {
    color: var(--orange);
    font-size: 0.875rem;
    opacity: 0.5;
  }
  .mobile-menu__label {
    display: flex;
    gap: 1px;
  }
  .mobile-menu__label span {
    color: var(--orange);
  }

  .system__title {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .system__title p {
    font-weight: bold;
    font-size: 0.875rem;
  }
  .system__info {
    margin-top: 8px;
    margin-left: 24px;
  }
  .system__user {
    font-size: 0.875rem;
    color: var(--orange);
  }
  .system__user span {
    color: var(--text-white);
  }
  .system__uptime {
    font-size: 0.875rem;
    color: var(--text-grey);
  }
  .social-media {
    margin-top: 16px;
    margin-left: 24px;
    display: flex;
    gap: 16px;
  }
  .social-media p {
    font-size: 0.875rem;
    color: var(--text-grey-dark);
  }

  .hidden {
    display: none;
  }

  #logs-icon,
  #close-menu {
    transition: opacity 0.3s ease-out;
  }

  /* --- desktop: barra arriba, panel cae desde arriba --- */
  @media (min-width: 600px) {
    nav {
      height: 4rem;
    }
    :global(body) {
      padding-bottom: 0;
    }
    .nav {
      top: 0;
      bottom: auto;
      border-top: none;
      border-bottom: 1px solid #333333;
      padding-bottom: 0.5rem;
    }
    .mobile-menu {
      top: 4rem;
      bottom: auto;
      border-top: none;
      border-bottom: 1px solid #333333;
      transform: translateY(-10px);
      flex-direction: column;
    }
    .mobile-menu.show {
      transform: translateY(0);
    }
  }
</style>
